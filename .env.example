# Copy to .env (git-ignored) and fill in YOUR OWN values. Never commit .env.
# Gemini CLI loads this automatically when launched from agent/.

# Use Vertex AI so usage is billed to your own Google AI Pro developer credits
GOOGLE_GENAI_USE_VERTEXAI=true

# Your own Google Cloud project ID (the one linked to the billing account holding your credits)
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI location. "global" serves the newest Gemini models.
GOOGLE_CLOUD_LOCATION=global

# Make sure no API key overrides Vertex ADC login
GEMINI_API_KEY=
GOOGLE_API_KEY=
